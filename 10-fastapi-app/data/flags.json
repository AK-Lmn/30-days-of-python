  {
    "name": "One-Click Checkout Redesign",
    "description": "Streamlined checkout flow for mobile and desktop",
    "flag_type": "string",
    "enabled": true,
    "default_value": "legacy_v1",
    "rules": [
      {
        "id": "cf70b033",
        "name": "Internal Employees",
        "conditions": [
          {
            "attribute": "email",
            "operator": "ends_with",
            "value": "@flagforge.dev"
          }
        ],
        "serve_value": "variant_one_click",
        "rollout_percentage": null
      },
      {
        "id": "e24a7213",
        "name": "US and CA VIPs",
        "conditions": [
          {
            "attribute": "country",
            "operator": "in",
            "value": [
              "US",
              "CA"
            ]
          },
          {
            "attribute": "tier",
            "operator": "equals",
            "value": "vip"
          }
        ],
        "serve_value": "variant_express",
        "rollout_percentage": null
      }
    ],
    "tags": [
      "checkout",
